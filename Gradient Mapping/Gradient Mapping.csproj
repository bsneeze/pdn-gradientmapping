<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>pyrochild.effects.gradientmapping</RootNamespace>
    <AssemblyName>Gradient Mapping</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Where Paint.NET is installed. Override with -p:PdnDir=...\ (keep the trailing backslash). -->
    <PdnDir Condition="'$(PdnDir)' == ''">C:\Program Files\Paint.NET\</PdnDir>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <Product>Gradient Mapping</Product>
    <AssemblyTitle>Gradient Mapping</AssemblyTitle>
    <Description>Paint.NET Plugin</Description>
    <Company>Zach Walker, a.k.a. pyrochild</Company>
    <Copyright>Copyright © 2007-2026 Zach Walker</Copyright>

    <!--
      VersionPrefix is the Paint.NET version this is built for. The rest, yyMM.ddHH, tells builds
      apart: the time of the build, unless a release passes the stamp worked out from its commit
      (-p:GradientMappingBuildStamp=2610.0614; see .github/workflows/release.yml).
    -->
    <VersionPrefix>5.1</VersionPrefix>
    <GradientMappingBuildStamp Condition="'$(GradientMappingBuildStamp)' == ''">$([System.DateTime]::Now.ToString(yyMM)).$([System.DateTime]::Now.ToString(ddHH))</GradientMappingBuildStamp>
    <AssemblyVersion>$(VersionPrefix).$(GradientMappingBuildStamp)</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PaintDotNet.Base">
      <HintPath>$(PdnDir)PaintDotNet.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Core">
      <HintPath>$(PdnDir)PaintDotNet.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Data">
      <HintPath>$(PdnDir)PaintDotNet.Data.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Effects">
      <HintPath>$(PdnDir)PaintDotNet.Effects.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Effects.Core">
      <HintPath>$(PdnDir)PaintDotNet.Effects.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Primitives">
      <HintPath>$(PdnDir)PaintDotNet.Primitives.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.ComponentModel">
      <HintPath>$(PdnDir)PaintDotNet.ComponentModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.ObjectModel">
      <HintPath>$(PdnDir)PaintDotNet.ObjectModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Windows">
      <HintPath>$(PdnDir)PaintDotNet.Windows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="common\ColorWheel.resx">
      <DependentUpon>ColorWheel.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="PresetDropdown\InputBox.resx">
      <DependentUpon>InputBox.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.png" />
  </ItemGroup>


  <PropertyGroup>
    <GradientMappingEffectsDir>$(USERPROFILE)\Documents\paint.net App Files\Effects\</GradientMappingEffectsDir>
  </PropertyGroup>

  <Target Name="GradientMappingCopyToEffectsFolder" AfterTargets="Build">
    <MakeDir Directories="$(GradientMappingEffectsDir)" Condition="!Exists('$(GradientMappingEffectsDir)')" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GradientMappingEffectsDir)" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
